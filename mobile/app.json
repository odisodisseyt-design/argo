{
  "expo": {
    "name": "ARGO",
    "slug": "argo-mobile",
    "scheme": "argo",
    "version": "0.1.2",
    "runtimeVersion": { "policy": "appVersion" },
    "updates": {
      "url": "https://v3310666.hosted-by-vdsina.ru/api/updates/manifest",
      "enabled": true,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.argo.rpg"
    },
    "android": {
      "package": "org.argo.rpg",
      "versionCode": 26,
      "adaptiveIcon": {
        "backgroundColor": "#090D14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}