{
  "expo": {
    "name": "ARGO",
    "slug": "argo-mobile",
    "scheme": "argo",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.argo.rpg"
    },
    "android": {
      "package": "org.argo.rpg",
      "adaptiveIcon": {
        "backgroundColor": "#090D14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}